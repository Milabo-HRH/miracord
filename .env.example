# VoiceCordAI Environment Configuration
# Copy this file to .env and fill in your values

# ===================
# Required Settings
# ===================

# Discord bot token (required)
# Get yours at: https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Optional: register slash commands immediately in one development server.
# Remove this in production to use global command registration.
DISCORD_SYNC_GUILD_ID=

# V1 AI Provider API Keys (at least one required)
OPENAI_API_KEY=sk-your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
XAI_API_KEY=xai-your-api-key-here

# ===================
# Optional Settings
# ===================

# Provider: "gemini", "grok", or the local ChatGPT/Codex desktop bridge
# "desktop_voice". "openai" remains for upstream compatibility.
AI_SERVICE_PROVIDER=gemini

# Pinned realtime models
GEMINI_MODEL=gemini-3.1-flash-live-preview
GROK_MODEL=grok-voice-think-fast-2.0

# Provider-native web tools; V1 does not use MCP.
NATIVE_WEB_SEARCH_MODE=auto
PREFERRED_SEARCH_SOURCES=op.gg,leagueoflegends.com,wiki.leagueoflegends.com,reddit.com/r/ARAM
GROK_X_SEARCH_ENABLED=false

# ChatGPT/Codex desktop Voice bridge (Windows + Voicemeeter Banana).
# After installing Voicemeeter, reboot before selecting desktop_voice.
DESKTOP_VOICE_SEND_DEVICE=Voicemeeter Input
DESKTOP_VOICE_RECEIVE_DEVICE=Voicemeeter Out B2
DESKTOP_VOICE_HOST_API=MME
DESKTOP_VOICE_SAMPLE_RATE=48000
DESKTOP_VOICE_CHANNELS=2
DESKTOP_VOICE_FRAME_MS=20
DESKTOP_VOICE_RESPONSE_START_MS=60
DESKTOP_VOICE_RESPONSE_SILENCE_MS=900
DESKTOP_VOICE_RESPONSE_PREROLL_MS=200
DESKTOP_VOICE_VAD_AGGRESSIVENESS=1
DESKTOP_VOICE_AUTO_ROUTE=true
VOICEMEETER_REMOTE_DLL=C:\Program Files (x86)\VB\Voicemeeter\VoicemeeterRemote64.dll

# One shared conversation per guild. Each policy supports:
# barge_in, hold, ignore
SESSION_ROUTING_MODE=guild_serial
VOICE_ACCESS_MODE=implicit
WAKE_WORD_ENGINE=sherpa_onnx
WAKE_WORD_PHRASE=豆包豆包
ACTIVE_PARTICIPANT_SPEECH_POLICY=barge_in
NEW_PARTICIPANT_WAKE_POLICY=barge_in
CONVERSATION_IDLE_TIMEOUT_SECONDS=10
LIVE_INPUT_SILENCE_TIMEOUT_MS=10000
HELD_TURN_MAX_SECONDS=30
HELD_TURN_QUEUE_MAX=4

# Bot command prefix (default: /)
COMMAND_PREFIX=/

# Slash commands do not need Message Content Intent. Enable this only if you
# explicitly want legacy text-prefix commands too, and enable the matching
# privileged intent in Discord Developer Portal.
ENABLE_PREFIX_COMMANDS=false

# Connection check interval in seconds (default: 10.0)
CONNECTION_CHECK_INTERVAL=10.0

# Logging levels: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
LOG_LEVEL=INFO
LOG_CONSOLE_LEVEL=INFO

# Reaction emojis for bot interactions
REACTION_GRANT_CONSENT=👂
REACTION_TRIGGER_PTT=🎙️
