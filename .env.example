# MIRA.CORD Environment Configuration
# Copy this file to .env and fill in your values

# ===================
# Required Settings
# ===================

# Discord bot token (required)
# Get yours at: https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Optional: register slash commands immediately in one development server.
# Remove this in production to use global command registration.
DISCORD_SYNC_GUILD_ID=

# Optional: automatically join a voice channel when the bot starts. If the text
# channel is omitted, the server system channel or first writable text channel is used.
AUTO_CONNECT_ENABLED=false
AUTO_CONNECT_GUILD_ID=
AUTO_CONNECT_VOICE_CHANNEL_ID=
AUTO_CONNECT_TEXT_CHANNEL_ID=

# V1 AI Provider API Keys (at least one required)
OPENAI_API_KEY=sk-your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
XAI_API_KEY=xai-your-api-key-here

# ===================
# Optional Settings
# ===================

# Default API provider: "gemini". "openai" and "grok" remain supported alternatives.
# Local ChatGPT/Codex desktop bridge: "desktop_voice". Choose explicitly.
AI_SERVICE_PROVIDER=gemini

# Pinned realtime models
GEMINI_MODEL=gemini-3.1-flash-live-preview
# Gemini automatic activity detection is enabled with provider-default timing.
# Legacy manual-VAD snapshots only; not the normal Gemini response endpoint:
# GEMINI_LOCAL_VAD_SILENCE_MS=650
# Separate opt-in for provider-hosted Google Search. Local League/OP.GG tools
# remain available when this is false. Live API use consumes provider quota;
# eligible free-tier quota may apply, otherwise the API can incur charges.
GEMINI_GOOGLE_SEARCH_ENABLED=false
# Optional complete Gemini base prompt override (shared tool/context rules are appended).
# GEMINI_INSTRUCTIONS=Your assistant instructions
GROK_MODEL=grok-voice-think-fast-2.0
OPENAI_REALTIME_MODEL_NAME=gpt-realtime
# For reasoning-capable voice, use gpt-realtime-2.1 and set this to medium.
# Leave empty for gpt-realtime / gpt-realtime-1.5. More effort can add latency/cost.
OPENAI_REASONING_EFFORT=
OPENAI_VOICE=marin
# Grok supports "none" (lower latency) or "high".
GROK_REASONING_EFFORT=none
# OpenAI/Grok server VAD toggle. Gemini uses automatic provider VAD by default.
REALTIME_SERVER_VAD=true

# Applies to Gemini, GPT and Grok API adapters. Sends this computer's game as a
# shared reference, never as an inferred Discord speaker-to-champion binding.
LEAGUE_CONTEXT_ENABLED=true
LEAGUE_TOOLS_ENABLED=true
OPGG_PREFETCH_ENABLED=true

# Native for Grok; GPT uses a search_web function backed by Responses.
# Gemini Google Search is controlled separately above.
# Independent of OP.GG. Search runs only when requested, not while idle.
NATIVE_WEB_SEARCH_MODE=auto
PREFERRED_SEARCH_SOURCES=op.gg,leagueoflegends.com,wiki.leagueoflegends.com,reddit.com/r/ARAM
GROK_X_SEARCH_ENABLED=false
# Reuses OPENAI_API_KEY; does not change the Realtime voice model.
# One search per voice turn, no automatic retries, short in-memory cache.
OPENAI_WEB_SEARCH_MODEL=gpt-5.4-mini
OPENAI_WEB_SEARCH_REASONING_EFFORT=none
OPENAI_WEB_SEARCH_TIMEOUT_SECONDS=15
OPENAI_WEB_SEARCH_CACHE_SECONDS=60

# ChatGPT/Codex desktop Voice bridge (Windows + Voicemeeter Banana).
# After installing Voicemeeter, reboot before selecting desktop_voice.
# Opt-in continuous mixed human audio; bypasses wake/stop words and input gate.
DESKTOP_VOICE_ALWAYS_FORWARD=false
DESKTOP_VOICE_SEND_DEVICE=Voicemeeter Input
DESKTOP_VOICE_RECEIVE_DEVICE=Voicemeeter Out B2
DESKTOP_VOICE_HOST_API=MME
DESKTOP_VOICE_SAMPLE_RATE=48000
DESKTOP_VOICE_CHANNELS=2
DESKTOP_VOICE_FRAME_MS=20
DESKTOP_VOICE_RESPONSE_START_MS=60
DESKTOP_VOICE_RESPONSE_SILENCE_MS=900
DESKTOP_VOICE_RESPONSE_PREROLL_MS=200
DESKTOP_VOICE_VAD_AGGRESSIVENESS=1
DESKTOP_VOICE_AUTO_ROUTE=true
VOICEMEETER_REMOTE_DLL=C:\Program Files (x86)\VB\Voicemeeter\VoicemeeterRemote64.dll

# One shared conversation per guild. Each policy supports:
# barge_in, hold, ignore
SESSION_ROUTING_MODE=guild_serial
# Only the current speaker continues without waking; another user must wake to take over.
CROSS_USER_WAKE_REQUIRED=true
VOICE_ACCESS_MODE=implicit
WAKE_WORD_ENGINE=sherpa_onnx
WAKE_WORD_PHRASE=豆包
SHERPA_WAKE_WORD_SCORE=3.0
SHERPA_WAKE_WORD_THRESHOLD=0.1
# The Chinese keywords_control.txt uses 豆包 score 3.0 / threshold 0.05,
# including a neutral-tone pronunciation; false wakes remain possible.
# Optional model/keyword overrides must be nonempty if set.
# SHERPA_WAKE_WORD_MODEL_DIR=assets/wakeword_models/sherpa-onnx-kws-zipformer-wenetspeech-3.3M-2024-01-01
# SHERPA_WAKE_WORD_KEYWORDS_PATH=assets/wakeword_models/sherpa-onnx-kws-zipformer-wenetspeech-3.3M-2024-01-01/keywords_control.txt
# 结束 mutes only that user's input and lets the agent finish answering.
# 闭嘴 also cancels that user's current answer. All require a new wake to resume input.
STOP_WORD_ENABLED=true
STOP_WORD_PHRASES=闭嘴,结束
ACTIVE_PARTICIPANT_SPEECH_POLICY=barge_in
NEW_PARTICIPANT_WAKE_POLICY=barge_in
CONVERSATION_IDLE_TIMEOUT_SECONDS=10
# Local stuck-input safety timeout, separate from provider sentence detection.
LIVE_INPUT_SILENCE_TIMEOUT_MS=10000
VOICE_INPUT_GATE_ENABLED=true
# Digital RMS level, not room sound-pressure dB. Lower values admit quieter speech.
VOICE_INPUT_GATE_DBFS=-42
HELD_TURN_MAX_SECONDS=30
HELD_TURN_QUEUE_MAX=4
ACTIVE_SPEECH_VAD_AGGRESSIVENESS=2
ACTIVE_SPEECH_MIN_DURATION_MS=180
ACTIVE_SPEECH_MAX_GAP_MS=60
ACTIVE_SPEECH_COOLDOWN_MS=750
# A continuous utterance triggers once; only this user's silence rearms it.
ACTIVE_SPEECH_REARM_SILENCE_MS=350

# Bot command prefix (default: /)
COMMAND_PREFIX=/

# Slash commands do not need Message Content Intent. Enable this only if you
# explicitly want legacy text-prefix commands too, and enable the matching
# privileged intent in Discord Developer Portal.
ENABLE_PREFIX_COMMANDS=false

# Connection check interval in seconds (default: 10.0)
CONNECTION_CHECK_INTERVAL=10.0

# Logging levels: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
LOG_LEVEL=INFO
LOG_CONSOLE_LEVEL=INFO

# Local JSONL traces; details and replay workflow: OBSERVABILITY.md.
# Capture includes redacted transcripts/context/tool arguments/results and enables
# provider transcription (quota use and potentially additional API cost).
VOICE_OBSERVABILITY_ENABLED=true
VOICE_DIAGNOSTIC_CAPTURE=false
VOICE_OBSERVABILITY_MAX_BYTES=5000000
VOICE_OBSERVABILITY_BACKUPS=3
VOICE_DIAGNOSTIC_MAX_CHARS=32768
# VOICE_OBSERVABILITY_DIR=logs

# Reaction emojis for bot interactions
REACTION_GRANT_CONSENT=👂
REACTION_TRIGGER_PTT=🎙️
# Optional Pipecat cascade (install requirements-pipecat.txt in its own environment).
# AI_SERVICE_PROVIDER=pipecat
PIPE_STT_MODEL=gemini-3.5-transcribe-live
PIPE_STT_LANGUAGES=cmn-Hans-CN,en-US
PIPE_LLM_PROVIDER=google
PIPE_LLM_MODEL=gemini-3.8-flash
PIPE_THINKING=medium
# gemini works with GEMINI_API_KEY; fish/minimax require the keys below.
PIPE_TTS_PROVIDER=doubao
DOUBAO_API_KEY=
DOUBAO_API_KEY_FILE=
# Empty uses the selected provider's default model and (Gemini only) voice.
PIPE_TTS_MODEL=
PIPE_TTS_VOICE=
FISH_API_KEY=
FISH_API_KEY_FILE=
FISH_TTS_VOICE=0f08cacd3e354471a4b94dd00b4cc4a3
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_TTS_URL=https://api.minimax.io/v1/t2a_v2
PIPE_TURN_SILENCE_SECONDS=0.8
# Pipeline lifetime is independent of the 10-second user input gate.
PIPE_PREWARM=true
PIPE_CONNECTION_LIFETIME_SECONDS=2700
